# Reserved for the generation integration. The scaffold does not call an API.
# Set an explicit endpoint here; do not read a developer's Codex credentials.
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
# Set the exact model ID after verifying account access and cost.
IMAGE_MODEL=

# Local database initializer; relative paths resolve from the project root.
DATABASE_PATH=./data/image-studio.sqlite

# adapter-node production server. Use your HTTPS origin when deploying.
HOST=127.0.0.1
PORT=3000
ORIGIN=http://localhost:3000
